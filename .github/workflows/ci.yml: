name: Engine CI
on: [push, pull_request]

jobs:
  build-and-typecheck:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - uses: actions/setup-node@v4
        with:
          node-version: 22 # Updated from 20 to avoid deprecation warnings
          
      - name: Install Dependencies
        run: npm ci # Uses clean install based on package-lock.json
        
      - name: Compile TypeScript
        run: npm run build
